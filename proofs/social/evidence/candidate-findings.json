  "findings": [
    {
      "id": "PFM-license",
      "level": "DESK",
      "finding": "Root AGPLv3 LICENSE conflicts with UNLICENSED metadata in api/trigger package.json; README says fully owned by Day Moon Development. Source reuse not selected pending review. Hosted API rights separate."
    },
    {
      "id": "PFM-queue",
      "level": "DESK",
      "finding": "CreatePost returns database Post DTO after tasks.trigger(process-post), not confirmed provider publication. Trigger process-post maxAttempts1; scheduler ticks every2minutes; idempotency key is generated postID TTL1hour, not client external_id. deletePost deletes project-scoped DB row and no explicit task cancel in this method. Stuck processing worker can requeue. Runtime cancellation/response-loss proof absent."
    },
    {
      "id": "Postiz-queue",
      "level": "DESK",
      "finding": "postWorkflowV112 distinguishes postNow from scheduling sleep but both perform Temporal activities, read provider integration and publish later. Mutation proxy has maximumAttempts1; explicit workflow recovery distinguishes timeout/unknown. Source is promising, not proof. deletePost terminates workflow after repository delete; bounded accepted tail and cancellation still require SERVICE race replay."
    },
    {
      "id": "PFM-provider-retry",
      "level": "DESK",
      "finding": "Actual post-to-platform task maxAttempts2; outer maxAttempts1 does not establish single provider invocation. Unknown acceptance/crash replay remains required. Full payload and account are logged in source; credential logging exposure needs review before real tokens."
    },
    {
      "id": "Postiz-heartbeat",
      "level": "SIM exact upstream helper",
      "finding": "postiz-heartbeat-window.json: provider function executes while serverHeartbeatCalls=0 until first15s tick. Workflow classifies heartbeat timeout without details as safe retry. Actual Temporal crash-after-provider-acceptance reproduction required before selection."
    },
    {
      "id": "LinkedIn-metrics",
      "level": "DESK",
      "finding": "Postiz documents analytics for Pages only, not personal profile. Post for Me marketing claims personal analytics but pinned implementation calls organizationalEntityShareStatistics. Do not certify personal-profile performance numbers without actual scope/provider proof."
    }
  ]
}
