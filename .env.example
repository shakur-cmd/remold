# Frontend (Vite). Use an isolated backend for staging AuthKit rehearsals.
VITE_CONVEX_URL=https://your-isolated-deployment.convex.cloud
VITE_WORKOS_CLIENT_ID=client_your_staging_client
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback
VITE_WORKOS_API_HOSTNAME=
# Set to "hash" only on a static host without SPA rewrites.
VITE_ROUTER=browser

# Set WORKOS_CLIENT_ID on the selected Convex deployment with pnpm exec convex env set.
# JWT verification uses public keys; no WorkOS API secret belongs in VITE_ variables.
# Production must use a separate WorkOS production client, after the release gate.
